# ==============================================================================
# 行尾符与二进制处理策略
#
# 为什么需要这个文件：
#   Windows 下编辑器默认写 CRLF，若直接入库，与他人协作或在 Linux/CI 上检出时
#   会产生"整个文件都变了"的假 diff —— 一行真实改动淹没在几千行行尾差异里。
#   统一在仓库内以 LF 存储，检出时由 git 按平台转换，是最省心的做法。
# ==============================================================================

# 默认：git 自动识别文本，仓库内统一 LF
* text=auto eol=lf

# --- 强制按文本处理（EDA 可读的源文件格式）---
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# CSV：BOM 等物料清单，文本处理；文件内含 UTF-8 BOM(EF BB BF) 供 Excel 识别编码，
# git 只做行尾归一化，不会删除 BOM 字节
*.csv   text eol=lf

# --- 强制按二进制处理（防止 git 做行尾转换而损坏文件）---
# 为什么单列：git 对二进制文件的误判会造成静默损坏，
# 这类文件一旦损坏无法用 diff 察觉，只能在导出时才发现，代价极高。
#
# ★ .epro2 是本工程唯一的权威源文件（原理图+PCB），本质是 zip 容器。
#   必须以二进制处理：一旦被当作文本做行尾转换，工程将无法在 EDA 中导入。
*.epro2 binary
*.epru  binary
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.pptx  binary
*.step  binary
*.stp   binary
*.stl   binary
*.dxf   binary
*.dwg   binary
